# 说明：
# 1. 应用运行时请把这份文件复制为 .env.local，并在 .env.local 中维护完整配置。
# 2. 项目根目录的 .env 建议只保留 DATABASE_URL，供 Prisma CLI 使用。
#
# Prisma 连接的 MySQL 数据库。
# 本地开发一般就是本机 MySQL；数据库名建议保持 github_global。
DATABASE_URL="mysql://root:password@localhost:3306/github_global"

# 可选：如果当前网络不能直连 GitHub / OpenRouter，再打开这两个代理配置。
# 常见本地代理端口示例：
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"

# 用于加密保存敏感数据，例如用户填写的 OpenRouter API Key。
# 必须是 64 位十六进制字符串（对应 32 字节随机密钥）。
# 生成命令：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-key-here"

# GitHub App：同时负责“用户登录 / 用户授权”和“仓库访问、Webhook、创建 PR”。
# 这组值来自 GitHub Developers -> GitHub Apps。
# slug 是 GitHub App URL 里 /apps/<slug> 的那一段，建议显式填写，不要再靠名称推导。
# private key 需要把 pem 文件内容写成单行，原来的换行改成 \n。
# webhook secret 必须和 GitHub App 后台的 Webhook secret 完全一致。
# 如果启用了 user authorization web flow，callback URL 必须与后台配置完全一致。
GITHUB_APP_ID="your_github_app_id"
GITHUB_APP_CLIENT_ID="Iv1.1234567890abcdef"
GITHUB_APP_CLIENT_SECRET="your_github_app_client_secret"
GITHUB_APP_USER_CALLBACK_URL="http://localhost:3000/api/auth/callback"
GITHUB_APP_SLUG="your_github_app_slug"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET="your_github_webhook_secret"

# 站点的对外基础地址。
# 主要影响：
# 1. 登录成功后的服务端跳转地址
# 2. OpenRouter 请求里的 HTTP-Referer
# 如果只是纯本地开发，可填 http://localhost:3000
# 如果希望直接通过 ngrok 域名访问并登录，就填 ngrok 地址。
APP_BASE_URL="http://localhost:3000"

# GitHub App Webhook 的完整地址。
# 如果 GitHub App 的 Webhook 和站点是同一个域名，通常就是 APP_BASE_URL + /api/webhooks/github
# 如果以后想把 Webhook 单独放到别的公网地址，这里可以单独改，不影响站点登录地址。
GITHUB_APP_WEBHOOK_URL="http://localhost:3000/api/webhooks/github"

# 本地翻译任务队列的并发数。
# 数值越大，并发处理越多，但更容易触发 GitHub / 模型接口限流。
# 本地开发先用 3~5 通常最稳妥。
QUEUE_CONCURRENCY=5
